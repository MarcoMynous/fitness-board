# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication & Session
AUTH_SECRET="dev-super-secret-auth-key-change-in-production-min-32-chars-long"

# Email Delivery (Nodemailer SMTP - Configurable for Gmail, Brevo, SES, Mailgun, Mailpit)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="ulonnamugochukwu@gmail.com"

# Payments (Paystack for Nigeria/Africa or Stripe)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Applications URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Object Storage (Cloudflare R2 S3-Compatible)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="fitness-platform-media"

# Redis (Rate Limiting & Token Caching)
REDIS_URL="redis://localhost:6379"

# Cloudflare Turnstile (Bot Detection & CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
